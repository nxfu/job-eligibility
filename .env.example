# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Backend API (optional — defaults to https://job-api.gaury.dev)
VITE_PYTHON_API_URL=https://job-api.gaury.dev

# ─── Google OAuth ───
# Google OAuth is configured entirely in the Supabase dashboard.
# Go to: Supabase → Authentication → Providers → Google
# Set the Google Client ID and Client Secret there.
# Do NOT add the Google Client Secret as a frontend env var.
